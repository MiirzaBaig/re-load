# Reload sanitized configuration reference — see docs/environment-configuration.md

# Stream Pay webhook signature verification; server-side only, separate from API keys.
STREAM_WEBHOOK_SECRET=
# For website development fill only NEXT_PUBLIC_*; Edge secrets are deployed separately.
# Placeholders are not working credentials. Never bulk-upload this template.

# Website browser-safe configuration
# Supabase project URL; intentionally visible to the browser.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
# Browser-safe key from existing .env.local; RLS still enforces access.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
# Optional legacy browser-key fallback; code prefers this when set.
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# UI feature flag; provider must also be enabled in hosted Supabase.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED="false"

# Supabase server-only credentials (automatically injected in hosted Edge Functions)
# Server URL, not a secret.
SUPABASE_URL="https://your-project.supabase.co"
# Legacy public key used for user-authenticated Edge clients.
SUPABASE_ANON_KEY="your-anon-key"
# FULL PRIVILEGE: bypasses RLS. Retrieved through authenticated CLI; never browser-expose.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# Optional newer single-key alias; not required when anon key is available.
SUPABASE_PUBLISHABLE_KEY=
# Optional newer privileged-key alias; not required when service-role key is available.
SUPABASE_SECRET_KEY=

# Shared backend URLs and cryptographic keys
# Production redirect/link origin. Documented URL, not a hosted-value export.
APP_URL="https://www.reload.sa"
# Existing base64 encryption key for stored commerce credentials. Do not regenerate casually.
INTEGRATION_ENCRYPTION_KEY="your-existing-encryption-key"
# Existing signing secret for verified return/order facts.
RETURN_TOKEN_SECRET="your-existing-return-token-secret"

# Salla public app
# Public app client ID confirmed by owner; app ID 1155852112.
SALLA_CLIENT_ID="your-salla-client-id"
# Current public-app OAuth client secret; cannot be read back from hosted Edge secrets.
SALLA_CLIENT_SECRET="your-salla-client-secret"
# Signature secret that must match the app webhook security settings.
SALLA_WEBHOOK_SECRET="your-salla-webhook-secret"
# Custom OAuth callback URL; documented configuration.
SALLA_REDIRECT_URI="https://your-project.supabase.co/functions/v1/salla-oauth-callback"
# Safety flag: absent in hosted secret inventory; code defaults to disabled.
SALLA_PUBLIC_APP_READY="false"

# Meta WhatsApp production channel
# Registered production phone ID, confirmed by owner; nonsecret.
WHATSAPP_PHONE_NUMBER_ID="your-production-phone-number-id"
# Registered production phone number, confirmed by owner; nonsecret.
WHATSAPP_DISPLAY_PHONE_NUMBER="+966XXXXXXXXX"
# MISSING stored value. Latest owner confirmation: 2165590787358223; earlier notes: 2003054410376909. Verify live association before filling.
WHATSAPP_WABA_ID="your-current-waba-id"
# Current system-user API token; not the expired Graph Explorer token.
WHATSAPP_ACCESS_TOKEN="your-current-system-user-token"
# App secret for RELOAD app 4582556568654842; validates webhook signatures.
WHATSAPP_APP_SECRET="your-meta-app-secret"
# Custom webhook challenge token; must match Meta callback settings.
WHATSAPP_VERIFY_TOKEN="your-existing-webhook-verify-token"
# MISSING stored version. Shared sender code fallback is v25.0; do not infer from webhook field version.
WHATSAPP_GRAPH_VERSION="v25.0"
# Internal team alert destination (digits/E.164 as supported); hosted value unavailable.
WHATSAPP_ALERT_RECIPIENT="your-authorized-alert-number"

# Ollama Cloud
# Text and vision provider key; source is hosted Edge secrets, not frontend.
OLLAMA_API_KEY="your-ollama-api-key"
# Optional override; absent in hosted secret inventory. Code default shown.
OLLAMA_TEXT_MODEL="deepseek-v4.1-flash"
# Optional override; absent in hosted secret inventory. Code default shown.
OLLAMA_VISION_MODEL="gemma4:31b"

# Resend order-email OTP
# Sending API key; also used separately in hosted Auth SMTP configuration.
RESEND_API_KEY="your-current-resend-api-key"
# Documented verified sender; stored hosted value was not exported.
OTP_EMAIL_FROM="Reload <no-reply@notify.reload.sa>"
# Existing keyed-hash secret for order-email challenges; do not rotate casually.
OTP_HASH_SECRET="your-existing-otp-hash-secret"

# Stream billing — server-only. Never use NEXT_PUBLIC_ for credentials.
STREAM_BILLING_ENV=sandbox
# Encoded x-api-key from the sandbox key pair.
STREAM_SANDBOX_X_API_KEY=
# Signing secret for the separate sandbox receiver.
STREAM_SANDBOX_WEBHOOK_SECRET=
# Registered Stream sandbox customer; must match the Stream account user.
STREAM_SANDBOX_CUSTOMER_EMAIL=
# Authorized Reload team test logins, comma-separated.
STREAM_SANDBOX_ALLOWED_EMAILS=
# Encoded live x-api-key; live billing remains off until accepted.
STREAM_X_API_KEY=
STREAM_LIVE_BILLING_ENABLED=false
# Extra bundles stay off until price approval and catalogue configuration.
STREAM_BUNDLES_ENABLED=false

# Server-to-server billing verifier token; configure the same value in Next and Edge secrets.
STREAM_INTERNAL_VERIFY_TOKEN=

# Zid partner OAuth app; server-only. Independent from merchant MCP links.
ZID_CLIENT_ID=
ZID_CLIENT_SECRET=
# Development-only OAuth verification; leave disabled until configured and migrated.
ZID_DEV_OAUTH_ENABLED=false
# Exact browser origin: HTTPS tunnel/preview for development, no path or trailing route.
ZID_OAUTH_ORIGIN=
# Explicit Zid DEVELOPMENT store IDs only; do not add production merchants.
ZID_DEV_STORE_IDS=
# Separate 32-byte base64 key for temporary development tokens. Not the production integration key.
ZID_DEV_ENCRYPTION_KEY=
