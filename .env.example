NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
# WhatsApp Cloud API — server-side Supabase Edge Function secrets only.
# Never prefix these with NEXT_PUBLIC_ or commit real values.
WHATSAPP_PHONE_NUMBER_ID=your-registered-phone-number-id
WHATSAPP_WABA_ID=your-whatsapp-business-account-id
WHATSAPP_ACCESS_TOKEN=your-system-user-or-test-access-token
WHATSAPP_APP_SECRET=your-meta-app-secret
WHATSAPP_VERIFY_TOKEN=generate-a-long-random-value
WHATSAPP_ALERT_RECIPIENT=9665XXXXXXXX
OLLAMA_VISION_MODEL=gemma4:31b-cloud
